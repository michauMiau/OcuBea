<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.OcuBea" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/green_primary</item>
        <item name="colorPrimaryVariant">@color/green_hover</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
    </style>

    <style name="Theme.OcuBea.NoActionBar" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- Settings screen: dark, compact, consistent with the WebUI palette -->
    <style name="SectionHead">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#4CAF50</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>

    <style name="Label">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">#8b949e</item>
        <item name="android:layout_marginBottom">4dp</item>
    </style>

    <style name="InputBg">
        <item name="android:background">@drawable/input_bg</item>
    </style>

    <style name="Check">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">#e6edf3</item>
        <item name="android:padding">10dp</item>
        <item name="android:layout_marginBottom">4dp</item>
    </style>

    <style name="ActionBtn">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">46dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">#e6edf3</item>
        <item name="android:backgroundTint">#21262d</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>

    <style name="InfoLine">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">#8b949e</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:paddingBottom">4dp</item>
    </style>
</resources>
