<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0d1117">

    <!-- Live preview fills the screen; controls float on top -->
    <com.ocubea.ui.LivePreviewView
        android:id="@+id/livePreview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
            android:baselineAligned="false"
        android:gravity="center_vertical"
        android:background="#99000000"
        android:padding="10dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OcuBea"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#4CAF50"/>

            <TextView
                android:id="@+id/tvUrl"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="12sp"
                android:textColor="#9E9E9E"
                android:fontFamily="monospace"/>

        </LinearLayout>

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Stopped"
            android:textSize="13sp"
            android:textColor="#ffffff"/>

    </LinearLayout>

    <!-- Bottom control bar.
         This bar is pinned to the bottom edge with layout_gravity="bottom", which puts
         it UNDER the system navigation bar. Its wrap_content height then gets clipped and
         the vertical LinearLayout squeezes the LAST row down to ~20px, leaving those buttons
         (night/motion/screen-off/settings/exit) untappable.
         Fix: give the bar a fixed height that is explicitly tall enough for both rows
         (8+46+46+8 = 108dp) and lift it clear of the navigation bar with a bottom margin. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="72dp"
        android:orientation="vertical"
        android:background="#CC000000"
        android:padding="8dp">

        <!-- Row 1: primary controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <Button
                android:id="@+id/btnToggleStream"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1.2"
                android:layout_margin="2dp"
                android:text="▶ Start"
                android:textSize="11sp"
                android:backgroundTint="#2E7D32"
                android:textColor="#ffffff"
                android:paddingLeft="2dp"
                android:paddingRight="2dp"/>

            <Button
                android:id="@+id/btnTorch"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_margin="2dp"
                android:text="🔦"
                android:textSize="13sp"
                android:backgroundTint="#37474F"
                android:textColor="#ffffff"
                android:paddingLeft="2dp"
                android:paddingRight="2dp"/>

            <Button
                android:id="@+id/btnFlip"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_margin="2dp"
                android:text="🔄"
                android:textSize="13sp"
                android:backgroundTint="#37474F"
                android:textColor="#ffffff"
                android:paddingLeft="2dp"
                android:paddingRight="2dp"/>

            <Button
                android:id="@+id/btnZoomIn"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_margin="2dp"
                android:text="🔍+"
                android:textSize="13sp"
                android:backgroundTint="#37474F"
                android:textColor="#ffffff"
                android:paddingLeft="2dp"
                android:paddingRight="2dp"/>

            <Button
                android:id="@+id/btnZoomOut"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_margin="2dp"
                android:text="🔍−"
                android:textSize="13sp"
                android:backgroundTint="#37474F"
                android:textColor="#ffffff"
                android:paddingLeft="2dp"
                android:paddingRight="2dp"/>

        </LinearLayout>

        <!-- Row 2: secondary controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <Button
                android:id="@+id/btnNightVision"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1.2"
                android:layout_margin="2dp"
                android:text="🌙"
                android:textSize="13sp"
                android:backgroundTint="#37474F"
                android:textColor="#ffffff"
                android:paddingLeft="2dp"
                android:paddingRight="2dp"/>

            <Button
                android:id="@+id/btnMotion"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_margin="2dp"
                android:text="🚨"
                android:textSize="13sp"
                android:backgroundTint="#37474F"
                android:textColor="#ffffff"
                android:paddingLeft="2dp"
                android:paddingRight="2dp"/>

            <Button
                android:id="@+id/btnScreenOff"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_margin="2dp"
                android:text="🌑"
                android:textSize="13sp"
                android:backgroundTint="#37474F"
                android:textColor="#ffffff"
                android:paddingLeft="2dp"
                android:paddingRight="2dp"/>

            <Button
                android:id="@+id/btnSettings"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_margin="2dp"
                android:text="⚙"
                android:textSize="13sp"
                android:backgroundTint="#37474F"
                android:textColor="#ffffff"
                android:paddingLeft="2dp"
                android:paddingRight="2dp"/>

            <Button
                android:id="@+id/btnRealLauncher"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_margin="2dp"
                android:text="🏠"
                android:textSize="13sp"
                android:backgroundTint="#37474F"
                android:textColor="#ffffff"
                android:paddingLeft="2dp"
                android:paddingRight="2dp"
                android:contentDescription="Exit to launcher"/>

        </LinearLayout>

    </LinearLayout>

    <!-- Top-right corner: leave kiosk mode -->
    <ImageButton
        android:id="@+id/btnExitKiosk"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="58dp"
        android:layout_marginEnd="10dp"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        android:contentDescription="Exit kiosk"
        android:alpha="0.3"
        android:background="?attr/selectableItemBackgroundBorderless"/>

</FrameLayout>
