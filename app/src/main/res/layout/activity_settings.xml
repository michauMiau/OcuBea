<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0d1117"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#4CAF50"
            android:layout_marginBottom="2dp"/>

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/status_stopped"
            android:textSize="14sp"
            android:textColor="#8b949e"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/btnStartStop"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/start_stream"
            android:textSize="15sp"
            android:textColor="#ffffff"
            android:backgroundTint="#2E7D32"
            android:layout_marginBottom="20dp"/>

        <!-- Server -->
        <TextView style="@style/SectionHead" android:text="@string/sec_server"/>

        <TextView style="@style/Label" android:text="@string/lbl_port"/>
        <EditText
            android:id="@+id/editTextPort"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:background="@drawable/input_bg"
            android:padding="12dp"
            android:inputType="number"
            android:hint="8080"
            android:textColor="#e6edf3"
            android:textColorHint="#8b949e"
            android:textSize="15sp"/>

        <TextView style="@style/Label" android:text="@string/lbl_access_token"/>
        <EditText
            android:id="@+id/editTextToken"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:background="@drawable/input_bg"
            android:padding="12dp"
            android:inputType="textPassword"
            android:hint="@string/hint_token_empty"
            android:textColor="#e6edf3"
            android:textColorHint="#8b949e"
            android:textSize="15sp"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/hint_access_token"
            android:textSize="11sp"
            android:textColor="#8b949e"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp"/>

        <TextView style="@style/Label" android:text="@string/lbl_device_name"/>
        <EditText
            android:id="@+id/editTextDeviceName"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:background="@drawable/input_bg"
            android:padding="12dp"
            android:inputType="text"
            android:hint="OcuBea"
            android:textColor="#e6edf3"
            android:textColorHint="#8b949e"
            android:textSize="15sp"
            android:layout_marginBottom="12dp"/>

        <!-- Video -->
        <TextView style="@style/SectionHead" android:text="@string/sec_video"/>

        <TextView style="@style/Label" android:text="@string/lbl_resolution"/>
        <Spinner
            android:id="@+id/spinnerResolution"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:background="@drawable/input_bg"
            android:padding="10dp"
            android:layout_marginBottom="12dp"/>

        <TextView style="@style/Label" android:text="@string/lbl_frame_rate"/>
        <Spinner
            android:id="@+id/spinnerFPS"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:background="@drawable/input_bg"
            android:padding="10dp"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:id="@+id/labelQuality"
            style="@style/Label"
            android:text="@string/quality_label"/>
        <SeekBar
            android:id="@+id/seekQuality"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:max="60"
            android:progress="42"
            android:layout_marginBottom="12dp"/>

        <!-- Toggles -->
        <TextView style="@style/SectionHead" android:text="@string/sec_features"/>

        <CheckBox
            android:id="@+id/checkboxNightVision"
            style="@style/Check"
            android:text="@string/chk_night_vision"/>

        <CheckBox
            android:id="@+id/checkboxMic"
            style="@style/Check"
            android:text="@string/chk_mic"/>

        <CheckBox
            android:id="@+id/checkboxSecurity"
            style="@style/Check"
            android:text="@string/chk_security"/>

        <CheckBox
            android:id="@+id/checkboxAutostart"
            style="@style/Check"
            android:text="@string/chk_autostart"/>

        <CheckBox
            android:id="@+id/checkboxPowerSaving"
            style="@style/Check"
            android:text="@string/chk_power_saving"/>

        <!-- Security detail -->
        <TextView style="@style/SectionHead" android:text="@string/sec_motion"/>

        <TextView
            android:id="@+id/labelSensitivity"
            style="@style/Label"
            android:text="@string/sensitivity_label"/>
        <SeekBar
            android:id="@+id/seekSensitivity"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:max="100"
            android:progress="50"
            android:layout_marginBottom="12dp"/>

        <TextView style="@style/Label" android:text="@string/lbl_pre_record"/>
        <SeekBar
            android:id="@+id/seekPreRecord"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:max="10"
            android:progress="2"
            android:layout_marginBottom="12dp"/>

        <TextView style="@style/Label" android:text="@string/lbl_max_clip"/>
        <SeekBar
            android:id="@+id/seekMaxClip"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:max="360"
            android:progress="30"
            android:layout_marginBottom="16dp"/>

        <!-- Diagnostics -->
        <TextView style="@style/SectionHead" android:text="@string/sec_diagnostics"/>

        <Button
            android:id="@+id/btnRestartCamera"
            style="@style/ActionBtn"
            android:text="@string/btn_restart_camera"/>

        <Button
            android:id="@+id/btnShowLog"
            style="@style/ActionBtn"
            android:text="@string/btn_show_log"/>

        <TextView
            android:id="@+id/tvLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/input_bg"
            android:padding="10dp"
            android:textColor="#8b949e"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:visibility="gone"
            android:layout_marginBottom="16dp"/>

        <!-- Addresses -->
        <TextView style="@style/SectionHead" android:text="@string/sec_addresses"/>

        <TextView
            android:id="@+id/tvInfoWebUI"
            style="@style/InfoLine"
            android:text="@string/addr_web_ui"/>
        <TextView
            android:id="@+id/tvInfoStream"
            style="@style/InfoLine"
            android:text="@string/addr_stream"/>
        <TextView
            android:id="@+id/tvInfoSnapshot"
            style="@style/InfoLine"
            android:text="@string/addr_snapshot"/>
        <TextView
            android:id="@+id/tvInfoAudio"
            style="@style/InfoLine"
            android:text="@string/addr_audio"/>
        <TextView
            android:id="@+id/tvInfoOnvif"
            style="@style/InfoLine"
            android:text="ONVIF: –"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="32dp"/>

    </LinearLayout>
</ScrollView>
