<?xml version="1.0" encoding="utf-8"?>
<!--
  Round variant for Android 6 and 7, identical to ic_launcher.xml on purpose.

  The launcher applies its own mask, so baking a circle in would double it on a
  round device and crop the lens on a square one. Kept as a separate file because
  the manifest points at both names and some launchers ask for this one
  specifically.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="48dp"
    android:height="48dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:pathData="M0,0h108v108h-108z"
        android:fillColor="#FF4CAF50" />

    <path
        android:pathData="M54,54m-31,0a31,31 0,1 1,62 0a31,31 0,1 1,-62 0"
        android:fillColor="#FFFFFFFF" />

    <path
        android:pathData="M54,54m-20,0a20,20 0,1 1,40 0a20,20 0,1 1,-40 0"
        android:fillColor="#FF1B5E20" />

    <path
        android:pathData="M54,54m-10,0a10,10 0,1 1,20 0a10,10 0,1 1,-20 0"
        android:fillColor="#FFFFFFFF" />

    <path
        android:pathData="M46,46m-5,0a5,5 0,1 1,10 0a5,5 0,1 1,-10 0"
        android:fillColor="#FFFFFFFF" />
</vector>
