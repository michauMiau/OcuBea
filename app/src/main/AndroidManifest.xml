<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Permissions -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <!-- API 34 splits FOREGROUND_SERVICE_CAMERA into per-type permissions;
         without this, startForeground() with type microphone throws on Android 14+.
         Ignored on older versions, which have no such requirement. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- Camera features -->
    <uses-feature android:name="android.hardware.camera" android:required="true" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <application
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.OcuBea"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="true">
        <!--
        usesCleartextTraffic is a boolean and a domain-config cannot override it.
        On the Android 6 phone (API 23) the app's own request to
        http://127.0.0.1:8080/status.json failed with

            UnknownServiceException: CLEARTEXT communication not supported: []

with network_security_config.xml present and its loopback domain-config
carving out 127.0.0.1, localhost and 10.0.2.2, and with this attribute set to
false. The cleartext decision on that device follows this manifest attribute;
the per-domain file does not loosen it.

So the attribute is true and the narrowing lives in one place: the file. Setting
this to false is the change that silently permits cleartext to every host the
app might ever reach, which is why the file exists at all.

The LAN risk is unchanged either way and is not something this attribute can
express: OcuBea *is* the camera server, so the peers are browsers and VMS
clients outside this app, and a socket the app binds and serves is not
restricted by any manifest flag.
        -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:keepScreenOn="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.OcuBea.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@style/Theme.OcuBea.NoActionBar"
            android:label="OcuBea Settings"
            android:parentActivityName=".MainActivity"/>

        <!-- Span-cost report. Not exported: it is a diagnostic surface over
             numbers this process already holds, and an exported one would let
             any app on the device read a fingerprint of the device's speed. -->
        <activity
            android:name=".perf.PerfActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@style/Theme.OcuBea.NoActionBar"
            android:label="@string/perf"
            android:parentActivityName=".MainActivity"/>

        <!-- Native clip management. Needs network permission for the loopback
             player; that permission is already held for the live stream. -->
        <activity
            android:name=".ui.ClipActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@style/Theme.OcuBea.NoActionBar"
            android:label="@string/clips"
            android:parentActivityName=".MainActivity"/>

        <service
            android:name=".service.StreamService"
            android:exported="false"
            android:foregroundServiceType="camera|microphone" />

        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
